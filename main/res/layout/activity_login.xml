<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Space android:layout_width="1dp" android:layout_height="45dp"/><TextView android:text="TradeStore" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Retail &amp; Inventory Management" android:textColor="@color/text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/etUsername" android:hint="Username / Email" android:background="@drawable/bg_input" android:padding="15dp" android:layout_marginTop="35dp" android:layout_width="match_parent" android:layout_height="56dp"/>
<EditText android:id="@+id/etPassword" android:hint="Password" android:inputType="textPassword" android:background="@drawable/bg_input" android:padding="15dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="56dp"/>
<Spinner android:id="@+id/spRole" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"/>
<Button android:id="@+id/btnLogin" android:text="LOGIN" android:textColor="@android:color/white" android:background="@drawable/bg_primary" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:id="@+id/tvRegister" android:text="Create new account" android:textColor="@color/primary" android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>